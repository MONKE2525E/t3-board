{
  "name": "t3-board",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "node --experimental-strip-types src/server.ts",
    "start": "node --experimental-strip-types src/server.ts",
    "install:omarchy": "node scripts/install-omarchy.mjs",
    "build": "vite build",
    "check": "tsc --noEmit",
    "lint": "eslint src web tests",
    "test": "node --experimental-strip-types --test tests/*.test.ts",
    "format": "prettier --write src web tests *.json *.js *.ts"
  },
  "dependencies": {
    "node-hid": "3.4.0"
  },
  "devDependencies": {
    "@types/node": "^26.0.0",
    "eslint": "^9.0.0",
    "prettier": "^3.9.9",
    "typescript": "~6.0.0",
    "typescript-eslint": "^8.0.0",
    "vite": "8.3.2"
  }
}
